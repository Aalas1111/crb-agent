[Unit]
Description=crb-agent 教室借用 agent（密钥保护的 HTTP 界面 + 流式对话）
# 指向部署后的那份文档（路径就是仓库里的 docs/deploy.md）。刻意不写 GitHub 链接：
# 这个仓库还没有上游，编一个地址比没有地址更糟。
Documentation=file:/opt/crb-agent/docs/deploy.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yuque
Group=yuque
WorkingDirectory=/opt/crb-agent

# ① 复用 yuque-agent 的那份凭证（DEEPSEEK_API_KEY 在里面）——这是刻意的：
#    同一个 LLM key，不新增一份要维护的凭证。
# ② 本项目自己的（CRBA_KEY、YQA_REPO）放它自己的文件里。前面那个 `-` 是「缺了也
#    别让 systemd 先崩」：真缺了由程序自己报一句「请设置 CRBA_KEY」更好懂。
EnvironmentFile=/home/yuque/.yuque/agent.env
EnvironmentFile=-/home/yuque/.crb-agent/env

Environment=HOME=/home/yuque
Environment=PYTHONUNBUFFERED=1
Environment=UV_CACHE_DIR=/var/lib/crb-agent/.uv-cache
# crb / yqa 是 uv tool 装的，落在 ~/.local/bin —— 别依赖 systemd 的默认 PATH。
Environment=PATH=/home/yuque/.local/bin:/usr/local/bin:/usr/bin:/bin
# 会话留痕（一个会话一个 jsonl）。
Environment=CRBA_WORKSPACE=/var/lib/crb-agent/workspace
# 语雀侧的产出目录由 YQA_REPO 推出来（= <yuque_workspace>/<repo>/outbox）。
Environment=CRBA_YUQUE_WORKSPACE=/var/lib/yuque-agent/workspace
# 语雀侧的 CLI 没有被装成全局命令，而是在它自己的检出里用 uv 跑。
# 指过去（而不是再 `uv tool install` 一份）是刻意的：**让两个服务用同一个检出**，
# 版本与文案天然一致，也不会出现「两处都要更新」。
#
# ⚠️ 值里有空格，**必须用引号包住整个赋值**：systemd 在 `Environment=` 里
# 把空格当「多个赋值」的分隔符，不加引号会变成一堆 `Invalid environment
# assignment, ignoring: run` 之类的告警，然后那个变量根本没设上（实测踩过）。
Environment="CRBA_YQA_BIN=uv run --no-sync --project /opt/yuque-agent yqa"

# 8787 是 yqa serve-plan 的下载口（公开、无鉴权），这个服务用 8788。
Environment=CRBA_PORT=8788

ExecStart=/usr/local/bin/uv run --no-sync crba serve

Restart=always
RestartSec=15

# systemctl stop 时 Python 以 143（SIGTERM）退出，那是正常停止，不是故障。
SuccessExitStatus=143

# 加固：只需要读语雀产出、写自己的 workspace、对外监听。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# 放宽一项：要读 ~/.crb/auth.json（登录态）与语雀产出目录。
ReadWritePaths=/var/lib/crb-agent
# 路径前那个 `-` 是「不存在就跳过」。`~/.crb/` 在第一次扫码之前**不存在**，
# 而 ReadOnlyPaths 碰到不存在的路径会让 systemd 建命名空间失败
# （status=226/NAMESPACE，实测踩过）。这两条路径都归别的项目管，
# 不该因为它们的出现时序把我的服务挡在门外。
ReadOnlyPaths=-/var/lib/yuque-agent/workspace -/home/yuque/.crb -/home/yuque/.yuque

[Install]
WantedBy=multi-user.target
